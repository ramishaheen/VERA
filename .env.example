# ─────────────────────────────────────────────────────────────────────────────
# VERA Environment Configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Provider ─────────────────────────────────────────────────────────────

# OpenAI API key (required for OpenAI provider)
OPENAI_API_KEY=sk-your-openai-key-here

# Default model to use (can be overridden via the Settings panel in the UI)
VERA_MODEL=gpt-4o-mini

# Custom base URL — leave blank for OpenAI default.
# For LM Studio (local):  VERA_BASE_URL=http://localhost:1234/v1
# For any OpenAI-compatible proxy: set accordingly.
VERA_BASE_URL=

# ── Server ────────────────────────────────────────────────────────────────────

VERA_HOST=0.0.0.0
VERA_PORT=8000
